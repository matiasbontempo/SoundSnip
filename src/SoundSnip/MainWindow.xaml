<Window x:Class="SoundSnip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:SoundSnip"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="SoundSnip" Width="1080" Height="840" MinWidth="900" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <local:InverseBooleanConverter x:Key="InvBool" />
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#E04B4B" />

        <!-- Button with a Segoe MDL2 glyph (Tag) in front of its text (Content) -->
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,1,8,0"
                                       Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconAccentBtn" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,1,8,0"
                                       Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconOnlyBtn" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Content" Value=" " />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ============================================================ main UI -->
        <Grid Margin="24,16,24,12" IsEnabled="{Binding IsToolsReady}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- link bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                         ui:ControlHelper.PlaceholderText="Paste a YouTube link here…"
                         FontSize="15" Padding="12,9" MinHeight="42" VerticalContentAlignment="Center"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                         KeyDown="UrlBox_KeyDown" />
                <Button Grid.Column="1" Margin="8,0,0,0" MinHeight="42" Style="{StaticResource IconBtn}"
                        Tag="&#xE77F;" Content="Paste" Command="{Binding PasteCommand}"
                        ToolTip="Paste the link from your clipboard and load it" />
                <Button Grid.Column="2" Margin="8,0,0,0" MinHeight="42" MinWidth="116" Style="{StaticResource IconAccentBtn}"
                        Tag="{Binding PrimaryGlyph}" Content="{Binding PrimaryText}" Command="{Binding PrimaryActionCommand}" />
            </Grid>

            <!-- status -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <ProgressBar Maximum="1" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}"
                             Visibility="{Binding ProgressVisible, Converter={StaticResource B2V}}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- video card -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0"
                    Visibility="{Binding HasVideo, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="160" Height="90" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TitleText}" FontSize="18" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxHeight="52" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource Dim}" Margin="0,3,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;" VerticalAlignment="Center" Margin="0,1,8,0"
                                       Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                            <TextBlock Text="{Binding QualityText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- workspace -->
            <Grid Grid.Row="3" Margin="0,12,0,0">

                <!-- welcome -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                            Visibility="{Binding ShowWelcome, Converter={StaticResource B2V}}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D6;" FontSize="56" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                    <TextBlock Text="Grab the audio. Keep the part you want." FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,16" />
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="24"
                               Text="1.  Paste a YouTube link and press Load&#x0A;2.  Drag the two handles on the waveform to trim&#x0A;3.  Press Space to preview exactly what you'll get&#x0A;4.  Export in the best quality available" />
                </StackPanel>

                <!-- editor -->
                <Grid Visibility="{Binding IsEditorReady, Converter={StaticResource B2V}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <local:WaveformView x:Name="Wave" Grid.Row="0" MinHeight="150"
                        Waveform="{Binding Waveform}"
                        SelectionStart="{Binding SelStart, Mode=OneWay}"
                        SelectionEnd="{Binding SelEnd, Mode=OneWay}"
                        Playhead="{Binding Playhead, Mode=OneWay}"
                        AutoScroll="{Binding IsPlaying}"
                        WaveBrush="{DynamicResource SystemControlForegroundAccentBrush}"
                        HandleBrush="{DynamicResource SystemControlForegroundAccentBrush}"
                        BackgroundBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        TextBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        GridBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        PlayheadBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                    <!-- scroll + zoom -->
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollBar x:Name="WaveScroll" Orientation="Horizontal" VerticalAlignment="Center" Minimum="0"
                                   ValueChanged="WaveScroll_ValueChanged" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Style="{StaticResource IconOnlyBtn}" Tag="&#xE71F;" Click="ZoomOut_Click" ToolTip="Zoom out (mouse wheel)" />
                            <Button Style="{StaticResource IconOnlyBtn}" Tag="&#xE8A3;" Click="ZoomIn_Click" Margin="4,0,0,0" ToolTip="Zoom in (mouse wheel)" />
                            <Button Content="Zoom to selection" Click="ZoomSelection_Click" Margin="8,0,0,0" Padding="12,7" />
                            <Button Content="Show all" Click="ZoomAll_Click" Margin="4,0,0,0" Padding="12,7" />
                        </StackPanel>
                    </Grid>

                    <!-- transport -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconAccentBtn}" MinWidth="170"
                                    Tag="{Binding PlayGlyph}" Content="{Binding PlayLabel}" Command="{Binding PlayPauseCommand}"
                                    ToolTip="Play or stop the selected clip (Space)" />
                            <Button Style="{StaticResource IconBtn}" Margin="8,0,0,0" Tag="&#xE892;" Content="Hear start"
                                    Command="{Binding PreviewStartCommand}" ToolTip="Play the first 2 seconds of the clip, to check where it begins" />
                            <Button Style="{StaticResource IconBtn}" Margin="8,0,0,0" Tag="&#xE893;" Content="Hear end"
                                    Command="{Binding PreviewEndCommand}" ToolTip="Play the last 2 seconds of the clip, to check where it ends" />
                            <CheckBox Content="Loop" IsChecked="{Binding Loop}" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Style="{StaticResource Dim}" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" Width="110" VerticalAlignment="Center"
                                    TickFrequency="0.1" ToolTip="Preview volume" />
                            <TextBlock Text="{Binding PlayheadText}" FontFamily="Consolas" FontSize="13" Margin="18,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource Dim}" />
                        </StackPanel>
                    </Grid>

                    <!-- trim -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="Start" Style="{StaticResource Caption}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IconOnlyBtn}" Tag="&#xE76B;" Command="{Binding NudgeStartCommand}" CommandParameter="-1"
                                            ToolTip="Earlier by 0.1 s  (Shift: 1 s · Ctrl: 0.01 s)" />
                                    <TextBox Width="118" Margin="4,0" TextAlignment="Center" FontFamily="Consolas"
                                             Text="{Binding StartText, UpdateSourceTrigger=LostFocus}" KeyDown="TimeBox_KeyDown" />
                                    <Button Style="{StaticResource IconOnlyBtn}" Tag="&#xE76C;" Command="{Binding NudgeStartCommand}" CommandParameter="1"
                                            ToolTip="Later by 0.1 s  (Shift: 1 s · Ctrl: 0.01 s)" />
                                </StackPanel>
                                <Button Content="Set to playhead  (I)" Command="{Binding SetStartHereCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="End" Style="{StaticResource Caption}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IconOnlyBtn}" Tag="&#xE76B;" Command="{Binding NudgeEndCommand}" CommandParameter="-1"
                                            ToolTip="Earlier by 0.1 s  (Shift: 1 s · Ctrl: 0.01 s)" />
                                    <TextBox Width="118" Margin="4,0" TextAlignment="Center" FontFamily="Consolas"
                                             Text="{Binding EndText, UpdateSourceTrigger=LostFocus}" KeyDown="TimeBox_KeyDown" />
                                    <Button Style="{StaticResource IconOnlyBtn}" Tag="&#xE76C;" Command="{Binding NudgeEndCommand}" CommandParameter="1"
                                            ToolTip="Later by 0.1 s  (Shift: 1 s · Ctrl: 0.01 s)" />
                                </StackPanel>
                                <Button Content="Set to playhead  (O)" Command="{Binding SetEndHereCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="Clip length" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding LengthText}" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <Button Content="Select whole track" Command="{Binding SelectAllCommand}" Margin="0,8,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Fade in (seconds)" Style="{StaticResource Caption}" />
                                <ui:NumberBox Value="{Binding FadeIn, Mode=TwoWay}" Minimum="0" Maximum="30" SmallChange="0.1" LargeChange="1"
                                              SpinButtonPlacementMode="Inline" Width="130" IsEnabled="{Binding FadeEnabled}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Fade out (seconds)" Style="{StaticResource Caption}" />
                                <ui:NumberBox Value="{Binding FadeOut, Mode=TwoWay}" Minimum="0" Maximum="30" SmallChange="0.1" LargeChange="1"
                                              SpinButtonPlacementMode="Inline" Width="130" IsEnabled="{Binding FadeEnabled}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- export -->
                    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Save as" Style="{StaticResource Caption}" />
                                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"
                                          DisplayMemberPath="Label" MinWidth="380" HorizontalAlignment="Left"
                                          IsEnabled="{Binding IsExporting, Converter={StaticResource InvBool}}" />
                                <TextBlock Text="{Binding FormatHint}" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="660"
                                           HorizontalAlignment="Left" Style="{StaticResource Dim}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0" MinWidth="230">
                                <Button Style="{StaticResource IconAccentBtn}" MinHeight="46" HorizontalAlignment="Stretch"
                                        Tag="{Binding ExportButtonGlyph}" Content="{Binding ExportButtonLabel}" Command="{Binding ExportCommand}" />
                                <ProgressBar Maximum="1" Value="{Binding ExportProgress, Mode=OneWay}" Margin="0,10,0,0"
                                             Visibility="{Binding IsExporting, Converter={StaticResource B2V}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="{Binding HasExportMessage, Converter={StaticResource B2V}}">
                                <TextBlock Text="{Binding ExportMessage}" VerticalAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExportIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Style="{StaticResource IconBtn}" Tag="&#xE8B7;" Content="Show in folder" Margin="16,0,0,0"
                                        Command="{Binding ShowInFolderCommand}"
                                        Visibility="{Binding CanShowInFolder, Converter={StaticResource B2V}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- footer -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="12" Style="{StaticResource Dim}" TextWrapping="Wrap"
                               Text="Space play/stop  ·  I / O set start / end  ·  Wheel zoom  ·  Shift+wheel or right-drag to pan  ·  Drag on the waveform to select" />
                    <TextBlock Text="{Binding ToolsText}" FontSize="12" Style="{StaticResource Dim}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Tag="&#xE72C;" Content="Update downloader"
                        Command="{Binding UpdateToolsCommand}"
                        ToolTip="YouTube changes often. Update yt-dlp if downloads suddenly stop working." />
            </Grid>
        </Grid>

        <!-- ============================================================ first-run setup -->
        <Grid Visibility="{Binding IsSettingUp, Converter={StaticResource B2V}}"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <StackPanel MaxWidth="540" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="40" Margin="0,0,0,12"
                           Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                <TextBlock Text="Setting up SoundSnip" FontSize="26" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,22" Style="{StaticResource Dim}" LineHeight="22"
                           Text="One-time setup: downloading the open-source tools SoundSnip uses to fetch and process audio (about 140 MB). They are kept in your user profile, nothing is installed on your system, and no admin rights are needed." />
                <ProgressBar Maximum="1" Value="{Binding SetupFraction, Mode=OneWay}" Height="6"
                             Visibility="{Binding HasSetupError, Converter={StaticResource InvBoolToVis}}" />
                <TextBlock Text="{Binding SetupText}" Margin="0,10,0,0" Style="{StaticResource Dim}"
                           Visibility="{Binding HasSetupError, Converter={StaticResource InvBoolToVis}}" />
                <StackPanel Visibility="{Binding HasSetupError, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding SetupError}" TextWrapping="Wrap"
                               Foreground="{StaticResource ErrorBrush}" />
                    <Button Style="{StaticResource IconAccentBtn}" Tag="&#xE72C;" Content="Try again"
                            Command="{Binding RetrySetupCommand}" Margin="0,16,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
